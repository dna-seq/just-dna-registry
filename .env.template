# just-dna-registry configuration — copy to `.env` and fill in.
# Server settings use the REGISTRY_ prefix; the client CLI reads REGISTRY_URL/_TOKEN.
# Every commented line shows the code's own default; uncomment only to change it.

# ── Deployment mode (0.12) ────────────────────────────────────────────────────
# `prod` | `test`. Two deployments of one image: production refuses test-prefixed data outright, and
# the polygon (test) instance gains the delete verb that makes a burner publish disposable. An
# UNKNOWN value refuses to boot — a typo that resolved either way is invisible from a running server,
# and one direction arms a delete endpoint on production data.
#
# Defaults to `prod`, and that direction is deliberate: a missing or misspelled value must land on
# the strict side. An instance that silently believed it was a test box would mount a delete endpoint
# on production data; the opposite mistake only refuses a `test-` publish on the polygon and is
# obvious within one request.
#
# NOTE this reaches the SERVER process only. `REGISTRY_MODE` in a unit file or compose env does not
# reach an operator's shell, so ops commands run by hand need `registry --mode test …` — that is how
# a polygon sweep once ran under production's rules. `revalidate` and `upgrade` echo `mode=… db=…`
# before they act.
# REGISTRY_MODE=prod
#
# Neither `db_path` nor any cache path below is derived from the mode. Two instances on ONE host must
# therefore be given distinct REGISTRY_DB_PATH values, or they share one catalog.
#
# The prefix marking test data, in the namespace/account spelling. Module names allow no hyphens, so
# the module form (`test_`) is derived rather than configured twice. One flag, normalised per
# identifier — never configure it twice.
# REGISTRY_TEST_DATA_PREFIX=test-
#
# Namespaces matching this regex are classified "test/sandbox" for listing groups: surfaced under
# `?group=test` and hidden from the other tabs. Server-owned policy, not a client-supplied regex, so
# every consumer agrees on membership. On the polygon the default listing does NOT apply this
# exclusion — those spaces are the whole catalog there.
# REGISTRY_TEST_NAMESPACE_PATTERN=^(sandbox|test)([-_]|$)

# ── Storage ───────────────────────────────────────────────────────────────────
# Backend for compiled module artifacts: `local` (dev/self-hosted disk) or `hf` (HuggingFace Hub;
# HfStorage is not wired yet — use `local` for now).
REGISTRY_STORAGE_BACKEND=local
REGISTRY_LOCAL_STORAGE_DIR=data/artifacts

# HuggingFace Hub (for the pending `hf` backend). The server needs a WRITE token to manage the
# dataset repo. HF_TOKEN is the conventional name huggingface_hub reads; the server honors either.
# With storage_backend=hf the server validates this token (valid + write access) on startup and
# exits 1 if it's missing/read-only.
REGISTRY_HF_REPO_ID=just-dna-seq/registry
HF_TOKEN=
# REGISTRY_HF_TOKEN=            # optional override; falls back to HF_TOKEN

# ── Catalog DB ──────────────────────────────────────────────────────────────────
REGISTRY_DB_PATH=data/registry.db

# ── Backups ───────────────────────────────────────────────────────────────────
# Where `registry backup` and the automatic pre-destructive snapshots write. Unset = `backups/`
# beside db_path, which keeps a snapshot next to the thing it snapshots. The sequence only counts up
# and NEVER overwrites — it is not a ring buffer — so this directory grows until pruned deliberately.
# Pick a volume where that is fine.
# REGISTRY_BACKUP_DIR=
# Snapshot the DB before every destructive admin op. Off is supported (`--no-backup` per command, or
# this globally) for a scripted teardown where the DB is disposable, but the default is on: the ops
# that call it are the irreversible ones.
# REGISTRY_AUTO_BACKUP=true

# ── Artifact signing (SPEC §5, optional) ──────────────────────────────────────
# Point at an Ed25519 private key PEM and the server signs each published version's artifact.digest;
# the public key is served at GET /api/v1/pubkey for clients to pin. Unset = signing off, unsigned
# manifests. Separate file, never in the DB — `export-keys`/`import-keys` do not touch it.
# REGISTRY_SIGNING_KEY=

# ── Onboarding / quotas ───────────────────────────────────────────────────────
# Community self-service (0.3): accounts register with an install-id (proof-of-work) and may claim up
# to N namespaces. On by default; the PoW deters random spambots, not determined ones.
# REGISTRY_ALLOW_SELF_REGISTER=true
# REGISTRY_INSTALL_ID_DIFFICULTY=20
# REGISTRY_NAMESPACES_PER_ACCOUNT=5
# Cap on digests per batch POST /modules/lookup.
# REGISTRY_LOOKUP_BATCH_MAX=256

# ── Server-side enrich + recompile (publish) ─────────────────────────────────────
# Pinned Ensembl reference recorded in every manifest.
REGISTRY_ENSEMBL_REFERENCE=just-dna-seq/ensembl_variations

# Strict compile: refuse to publish a partial artifact when a variant is left without a genomic
# position, and escalate a ladder of checks from warning to error. On by default — it is what makes
# `compiled_by=marketplace-server` worth trusting. Turn OFF only while migrating a catalog; see
# `registry revalidate --recompile-check` for what a corpus would lose.
REGISTRY_COMPILE_STRICT=true
# ACMG BA1 lint threshold. Warning-only, so this tunes noise, never whether a publish succeeds.
# REGISTRY_BA1_THRESHOLD=0.05

# Enrichment (just-dna-enricher — the only tier permitted to fetch). It writes resolution.csv
# BEFORE the compile; the compiler then consumes it and never fetches for itself.
REGISTRY_ENRICH_ENABLED=true
# Offline = clamp to the local snapshots below, zero egress. Recommended on the publish path: an
# online enrich holds a worker for minutes and makes artifact.digest depend on WHEN you published.
REGISTRY_ENRICH_OFFLINE=true
# Always `best_effort`, and this is load-bearing rather than timid: enrich(mode="strict") raises
# BEFORE it writes resolution.csv, so a strict failure leaves no table to diagnose from and a re-run
# repeats the whole network pass. Letting the compiler's strict gate refuse keeps the table on disk
# and names the offending variants. Do not set this to strict.
# REGISTRY_ENRICH_MODE=best_effort
# Never provision a multi-hundred-MB snapshot from inside a request; `registry warm-caches` is the
# operator step that does it. A missing snapshot is a well-defined error, not a five-minute pull.
# REGISTRY_ENRICH_DOWNLOAD=false
# Refuse to boot when enrichment is offline and no snapshot is provisioned. Recommended in prod:
# in that state every strict publish of an rsID-authored module fails.
# REGISTRY_ENRICH_REQUIRE_CACHE=false
# REGISTRY_ENRICH_USE_CLINVAR=true
# REGISTRY_ENRICH_USE_GNOMAD=false     # ~6s per 20 variants, online only
# REGISTRY_ENRICH_MINT_VRS=true
# REGISTRY_ENRICH_VERIFY_REF=true      # auto-skipped offline (needs the reference sequence)
# Cross-check authored clinical significance against ClinVar. Warning-only in both modes by upstream
# design, so it never gates a publish. With no ClinVar snapshot the pass reports `clin_sig_not_checked`
# rather than zero conflicts — an empty list is the one shape where "nothing was wrong" and "nothing
# was checked" render identically.
# REGISTRY_ENRICH_VERIFY_CLINSIG=true
# REGISTRY_ENRICH_VERIFY_RSIDS=false   # live dbSNP only
# Record a pseudoautosomal locus once, on X, instead of on both X and Y.
# REGISTRY_ENRICH_KEEP_PAR_TWIN=false

# Reference snapshots. Provision with `registry warm-caches --apply`. Leave the REGISTRY_* ones
# unset to reuse an existing just-dna-lite deployment's caches via the shared base dir:
# JUST_DNA_PIPELINES_CACHE_DIR=/data/just-dna-lite/.cache/just-dna-pipelines
# Or point at each directly (an explicit path always wins over the base dir):
# REGISTRY_ENSEMBL_CACHE=
# REGISTRY_CLINVAR_CACHE=
# REGISTRY_CONSTRAINT_CACHE=
# REGISTRY_ACMG_SNAPSHOT_DIR=
#
# The licence-gated PGx snapshots (enricher 0.5.1). Only the `?pgx=` check reads these, so a
# deployment that never offers it needs none — but a HOSTED one that does needs them, because the
# alternative is fetching a source that forbids sale live, per request, on your own acceptance and
# your own personal PharmVar key, while every published rate figure for them is per IP. Tiny: CPIC is
# ~256 KB, PharmVar ~36 KB. Pull with `registry warm-caches --pgx --apply --use non_commercial`.
# REGISTRY_CPIC_CACHE=
# REGISTRY_CLINPGX_CACHE=
# PharmVar is BUILD-ONLY and that is deliberate upstream: its bulk data comes down under a key its
# terms §2 make personal and non-transferable, so nothing is published to pull. Build it once with
# `just-dna-enricher pharmvar build --out <dir>` and point this there. With it the PharmVar leg runs
# with no key at all, which is what you want on a public server.
# REGISTRY_PHARMVAR_CACHE=

# The remaining lanes. `caches.CACHE_LANES` is upstream's registry of every snapshot lane — 15 of
# them — and `registry warm-caches` reports and provisions the full set, wider than the seven any
# pass here opens. A lane this service never reads is still one an operator may want on the same box,
# since authoring commands often run beside the server.
# REGISTRY_CIVIC_CACHE=
# REGISTRY_DRUG_LABELS_CACHE=
# REGISTRY_MANE_CACHE=
# REGISTRY_MITOMAP_CACHE=
# REGISTRY_MITOMAP_MISS_CACHE=
# REGISTRY_PUBMIND_CACHE=
# REGISTRY_STRCHIVE_CATALOGUE=
#
# `alphagenome_avi` is the fifteenth lane and the ONE with no REGISTRY_ setting of its own — by
# design, not oversight: a lane with no override resolves under JUST_DNA_PIPELINES_CACHE_DIR (or the
# platformdirs default), which is the shared base every lane already agrees on. Point it directly
# with upstream's own variable if you need it somewhere else:
# JUST_DNA_ALPHAGENOME_AVI_CACHE=
#
# Provisioning it is a PULL from HuggingFace Hub and never a build — the 88.5 GB source sits behind
# an eligibility gate that bars classes of holder outright, so this tier cannot acquire it. That
# means it needs HF_TOKEN, and it is licence-gated, so `--use` applies:
# `registry warm-caches --lane alphagenome_avi --apply --use non_commercial`.
#
# Every lane also honours its own `JUST_DNA_*_CACHE` variable, and an operator who exports one
# directly OUTRANKS a path written into these settings. That is what `export_lane_locations` respects
# at boot: without it a pull would land where the running server never looks.

# Enrichment cost control. The per-caller rate buckets cap ONE caller; these cap the process, and
# they are the only thing bounding our outbound rate. gnomAD and NCBI throttle by IP — gnomAD has no
# API key at all — so overspending gets THIS SERVER throttled, for every user at once. Raising
# concurrency above 1 also races the enricher's pacing gate and multiplies egress. Do it deliberately.
# REGISTRY_ENRICH_MAX_CONCURRENCY=1
# The timeout and the variant cap are `/check` only. Publish is unattended, has already queued
# behind every interactive caller, and would lose a whole upload to a deadline, so it has none.
# REGISTRY_ENRICH_TIMEOUT_SECONDS=300
# REGISTRY_ENRICH_MAX_VARIANTS=500

# The idle lane: how publish yields to /check. A publish queues for an enrichment permit instead of
# failing on a full gate, and while queued it costs an event-loop task rather than a threadpool
# worker — which is the concession that matters, since that pool is what an interactive request
# needs to run at all. QUIET_SECONDS is how long the gate must be free of interactive *demand*
# (a rejected /check counts) before a queued publish may start; it is short on purpose, to stop a
# publish winning a race, not to hold it until the server is quiet for a long stretch.
# REGISTRY_ENRICH_IDLE_QUIET_SECONDS=5.0
# REGISTRY_ENRICH_IDLE_POLL_SECONDS=0.5
# Nice increment for the publish worker thread (0 disables). Applies to the compile, which is real
# CPU. The thread is created per publish and discarded, because raising a nice value is unprivileged
# and lowering it back is NOT — a reused pool worker could never be restored.
# REGISTRY_PUBLISH_NICE=10

# Outbound retry floor, applied to every enricher HTTP client at boot. The enricher already retries
# (tenacity, exponential jitter, paced before the retry) but bakes 3-4 attempts into import-time
# decorators — tuned for an author at a terminal who would rather see the failure. A server publish
# is unattended and a transient 502 costs a whole re-upload. Raised only, never lowered.
# REGISTRY_HTTP_RETRY_ATTEMPTS=5

# Politeness credentials for the enricher's NCBI / Europe PMC calls. BOTH OPTIONAL — the key only
# *tightens* NCBI pacing (1 request per 3s -> 1 per 0.1s), and neither applies to gnomAD, which is
# unauthenticated. Only read when enrichment runs online.
# NCBI_API_KEY=
# JUST_DNA_CONTACT_EMAIL=

# PharmVar, unlike those two, is REQUIRED for the leg that uses it — and it is personal: PharmVar's
# terms §2 make an account non-transferable. Presence of the key IS the switch for the PharmVar half
# of `/check?pgx=`; unset means CPIC carries that check alone. There is no separate boolean.
# NOTE on a PUBLIC deployment this means third parties query PharmVar on YOUR account.
# PHARMVAR_API_KEY=

# AlphaGenome. NOTHING in this service reads this key, and that is the whole answer to "why is it
# not here": the registry neither runs the AlphaGenome check nor builds its data. The key belongs to
# `just-dna-enricher`'s AVI *build* path (`alphagenome_avi_build`), which is authoring-side and gated
# — and provisioning the `alphagenome_avi` lane HERE is a pull from HuggingFace, which needs
# HF_TOKEN instead. Set it only if you also run enricher build commands on this box; the enricher
# reads it straight from the environment and the registry forwards only NCBI_API_KEY,
# JUST_DNA_CONTACT_EMAIL, PHARMVAR_API_KEY and HF_TOKEN.
#
# Output carries terms that travel INSIDE derivatives: no training of variant-effect models, and
# Google may demand deletion of Output already in your possession on breach. See the lane's recorded
# SourceTerms before distributing anything derived from it.
# ALPHAGENOME_API_KEY=

# Declared use — a third axis, orthogonal to strict/offline. Gates the PGx-family sources
# (PharmVar/CPIC/ClinPGx/ClinGen), every one of which is CC BY-SA *plus* a no-sale clause:
#   unstated (default) = a forbidding source is SKIPPED with a reason
#   non_commercial     = fetched, declaration recorded
#   commercial         = REFUSED at acquisition, nothing fetched
# Resolution / frequency / gene-metrics never consult it — none of those sources forbids sale.
# REGISTRY_DECLARED_USE=unstated

# `--use` also gates `registry warm-caches --pgx`: downloading a gated snapshot is TAKING the data,
# so `unstated` skips those two and `commercial` refuses them.

# ── Upload bounds ─────────────────────────────────────────────────────────────
# Applied to every spec upload (publish, import, validate, check).
#
# Two numbers, two costs. MAX_UPLOAD_BYTES bounds the bytes on the wire — summed multipart parts, or
# an archive's compressed size. MAX_EXTRACTED_BYTES bounds what an archive expands to, read from its
# member headers before anything is written.
#
# MAX_UPLOAD_BYTES mirrors the HAProxy request-body cap in front of the deployment, so an oversized
# body gets the registry's structured 413 instead of the proxy cutting the connection. Raising it
# above the proxy's own limit does not raise the ceiling — it only makes the failure opaque. Raise
# HAProxy first, or (better) send the spec compressed: a spec too large to send raw goes through on
# every route, including the dry runs — `registry-client check … --pack`.
# REGISTRY_MAX_UPLOAD_BYTES=26214400
# REGISTRY_MAX_EXTRACTED_BYTES=536870912
# REGISTRY_MAX_SPEC_FILES=64

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Per caller (API key or IP) x category, in-memory token buckets. An UNREGISTERED category is
# silently unlimited, so a new egressing route must land its bucket in the same commit as the route.
# REGISTRY_RATE_LIMIT_ENABLED=true
# REGISTRY_RATE_PUBLISH_PER_HOUR=10
# REGISTRY_RATE_DOWNLOAD_PER_HOUR=1000
# REGISTRY_RATE_SEARCH_PER_MIN=60
# REGISTRY_RATE_SOCIAL_PER_MIN=30      # star/unstar toggles
# REGISTRY_RATE_VALIDATE_PER_HOUR=60   # server CPU only
# REGISTRY_RATE_ENRICH_PER_HOUR=5      # IP-throttled public APIs + minutes of pacing
# Drafting (0.25). No egress — snapshot-only by construction — so this is not the shared-standing
# bound `enrich` is; it is CPU over a gene panel, plus an access bound on snapshots this deployment
# acquired under its own declared use.
# REGISTRY_RATE_DRAFT_PER_HOUR=10
# REGISTRY_RATE_HINT_PER_HOUR=600

# ── The hint proxy (0.25) ─────────────────────────────────────────────────────
# **The anonymous tier is the product, not a consolation prize.** A thin client with no Ensembl
# snapshot getting an rsID placed onto a coordinate, for free, at zero egress to anyone, is this
# surface working as designed — so anonymous callers are allowed, clamped to `offline=true`.
#
# Anonymous *online* is refused on both instances and does not vary by mode: gnomAD's limit is keyed
# on our IP and cannot be bought, so one anonymous caller can throttle every publisher on the box,
# and the pace ledger needs a stable identity to mean anything (a shared NAT makes the IP branch
# worthless as a cooldown key).
# REGISTRY_HINT_ENABLED=true
# REGISTRY_HINT_ALLOW_ANONYMOUS=true
# gnomAD behind its own switch, default OFF. 512 frequency lookups is 51 minutes of serialized pacing
# and 85% of what gnomAD grants the WHOLE deployment in an hour — the same allowance
# `/check?frequencies=true` draws on to gate a publish.
# REGISTRY_HINT_ALLOW_GNOMAD=false
# A batch is bounded by what can finish inside the request, not by a round number: an online batch
# runs its misses sequentially at the upstream's own pace.
# REGISTRY_HINT_MAX_BATCH=256
# REGISTRY_HINT_MAX_BATCH_ONLINE=20
# Waits up to this are absorbed in the coroutine; longer ones come back as 429 with a Retry-After.
# Past a couple of seconds, holding the connection open is a slowloris we consented to, and the
# header carries the same information for free.
# REGISTRY_HINT_INLINE_WAIT_SECONDS=2.0
# REGISTRY_HINT_MAX_INTERVAL_SECONDS=300.0
# The pace ledger's tiers. The cooldown is on the ALLOWANCE, not the tier: carrying the tier down one
# step per clean day leaves a hole a caller can sit in forever (spend exactly twice the allowance
# daily, end each day at tier 1, get the whole free tier back every morning). Halving the allowance
# per consecutive over-day ratchets, and one clean day restores it.
# REGISTRY_HINT_MAX_TIER=6
# REGISTRY_HINT_MIN_DAILY_UNITS=4

# ── Pagination ────────────────────────────────────────────────────────────────
# REGISTRY_DEFAULT_PER_PAGE=20
# REGISTRY_MAX_PER_PAGE=100

# ── Optional JWT sessions ─────────────────────────────────────────────────────
# Unset = JWT off, static API keys only (default). Set a ≥32-byte secret to enable
# POST /auth/tokens (exchange an API key for a short-lived JWT). Static keys keep working.
# REGISTRY_JWT_SECRET=
# REGISTRY_JWT_TTL_SECONDS=86400

# ── Console (0.23) ────────────────────────────────────────────────────────────
# Serve the browser console at /ui/ (and redirect / there). A static page over the same API this
# process serves — no extra dependency, no extra route in the OpenAPI schema — so it is on by
# default. Turn off for a deployment that fronts the API with its own site, or that wants / to stay
# a 404. `registry-client ui` serves the same page against a remote host and needs nothing enabled.
# REGISTRY_UI_ENABLED=true

# ── Logging / debug ───────────────────────────────────────────────────────────
# Verbose structured logging to stdout: request tracing + Eliot publish/import step logs +
# third-party (compiler/duckdb/uvicorn) DEBUG. Turn ON while bringing the server up / debugging.
REGISTRY_DEBUG=true
# When debug is off, this is the level (DEBUG|INFO|WARNING|ERROR).
REGISTRY_LOG_LEVEL=INFO

# ── Client CLI (registry-client) ──────────────────────────────────────────────
# REGISTRY_URL=https://module-registry.just-dna.life
# REGISTRY_TOKEN=mk_live_...
# HTTP timeout in seconds (default 600). Large modules recompile server-side for minutes;
# your reverse proxy (Caddy) must also allow long upstream responses.
# REGISTRY_TIMEOUT=600
